# Copy to .env (never commit .env) and fill in real values.

# ── Supabase ──────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key

# ── AI assistant (IBM Consulting Advantage) ──────────
# mock = built-in local responder, works with no IBM access
# ica  = call your IBM Consulting Advantage assistant API
AI_PROVIDER=mock

# IBM Consulting Advantage developer API (OpenAI-compatible).
# Key: ICA web app -> Settings -> API Keys -> ICA APIs
ICA_API_KEY=
# Endpoint. Use /assistants/... for an assistant you built in ICA,
# or /chat-models/chat/completions for a raw model.
ICA_API_URL=https://api.servicesessentials.ibm.com/v1/assistants/chat/completions
# The "id" of your assistant, from:
#   curl -H "Authorization: Bearer $ICA_API_KEY" https://api.servicesessentials.ibm.com/v1/assistants/models
ICA_MODEL=

# chat   = sends {"messages": [{"role": "system"|"user"|"assistant", "content": "..."}]}
# prompt = sends {"input": "<one combined prompt string>"}
ICA_API_STYLE=chat

# Header that carries the key. "Authorization" sends "Bearer <key>"; any other name
# (e.g. x-api-key) sends the raw key in that header.
ICA_AUTH_HEADER=Authorization

# Seconds to wait for the model before falling back
ICA_TIMEOUT=30
